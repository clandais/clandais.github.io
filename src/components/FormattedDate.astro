---
interface Props {
  date: Date;
  showDay?: boolean;
}

const { date, showDay } = Astro.props;
---

<time datetime={date.toISOString()}>
  {

    showDay ?
      date.toLocaleDateString("en-us", {
        month: "short",
        day: "numeric",
        year: "numeric",
      })
    :
    date.toLocaleDateString("en-us", {
      month: "short",
      year: "numeric",
    })
  }
</time>
