---
import Accordion from "@components/Accordion.astro";
import AccordionItem from "@components/AccordionItem.astro";

interface Props {
    title: string
}

const { title } = Astro.props as Props

---
<Accordion>
    <AccordionItem title={title} tagName="h6">
        <slot />
    </AccordionItem>
</Accordion>
